# Local development uses the existing SSH tunnel; replace for another endpoint.
MOVIE_AGENT_LLM_BASE_URL=http://localhost:8000/v1
MOVIE_AGENT_LLM_MODEL=movie-agent-brain
MOVIE_AGENT_LLM_API_KEY=local
MOVIE_AGENT_LLM_TIMEOUT=180
MOVIE_AGENT_LLM_MAX_TOKENS=16000
MOVIE_AGENT_LLM_ENABLE_THINKING=false
# Backend data root, independent of the serving endpoint.
MOVIE_AGENT_WORKSPACE=workspace/studio
