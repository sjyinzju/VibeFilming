# Local development uses the existing SSH tunnel; replace for another endpoint.
MOVIE_AGENT_LLM_BASE_URL=http://localhost:8000/v1
MOVIE_AGENT_LLM_MODEL=movie-agent-brain
MOVIE_AGENT_LLM_API_KEY=local
MOVIE_AGENT_LLM_TIMEOUT=180
MOVIE_AGENT_LLM_MAX_TOKENS=16000
MOVIE_AGENT_LLM_ENABLE_THINKING=false
# Backend data root, independent of the serving endpoint.
MOVIE_AGENT_WORKSPACE=workspace/studio

# P3 image bindings: mock | flux_direct. Real providers are opt-in with no Mock fallback.
MOVIE_AGENT_IMAGE_PROVIDER=mock
MOVIE_AGENT_FLUX_ENDPOINT=http://127.0.0.1:9001
MOVIE_AGENT_FLUX_TIMEOUT=660

# ComfyUI video remains opt-in. The built-in minimax_h3_fl2va profile uses a verified,
# versioned API-format workflow and semantic binding manifest.
MOVIE_AGENT_COMFYUI_ENDPOINT=http://127.0.0.1:8188
MOVIE_AGENT_COMFYUI_TIMEOUT=3600
MOVIE_AGENT_COMFYUI_WEBSOCKET_TIMEOUT=3600
MOVIE_AGENT_COMFYUI_WORKFLOW_PROFILE=minimax_h3_fl2va
MOVIE_AGENT_VIDEO_PROVIDER=mock
MOVIE_AGENT_VISION_PROVIDER=mock
MOVIE_AGENT_VISION_VIDEO_TRANSPORT=jpeg_sequence
# P4B real vision is explicit opt-in; a real failure never falls back to Mock.
MOVIE_AGENT_VISION_ENDPOINT=http://127.0.0.1:8001/v1
MOVIE_AGENT_VISION_MODEL=movie-agent-vision
MOVIE_AGENT_VISION_TIMEOUT=600
MOVIE_AGENT_VISION_MEDIA_REMOTE_ROOT=/home/Developer/runtime/vlm-media
MOVIE_AGENT_VISION_MAX_TOKENS=6000
MOVIE_AGENT_VISION_MINIMUM_SCORE=0.8
MOVIE_AGENT_VISION_PROFILE_THRESHOLDS={}
MOVIE_AGENT_VISION_STRUCTURED_OUTPUT=json_schema
MOVIE_AGENT_VISION_FAST_FRAMES=24
MOVIE_AGENT_VISION_FULL_FRAMES=40
MOVIE_AGENT_AUDIO_PROVIDER=mock
# P4D: set AUDIO_PROVIDER=real only after deploying/calibrating both services.
MOVIE_AGENT_TTS_ENDPOINT=http://127.0.0.1:8002
MOVIE_AGENT_TTS_MODEL=qwen3-tts-base
MOVIE_AGENT_TTS_TIMEOUT=600
MOVIE_AGENT_MUSIC_ENDPOINT=http://127.0.0.1:8003
MOVIE_AGENT_MUSIC_MODEL=acestep-v15-turbo
MOVIE_AGENT_MUSIC_TIMEOUT=900
MOVIE_AGENT_AUDIO_TASK_STATE_ROOT=workspace/_audio_tasks
MOVIE_AGENT_DIALOGUE_PRE_ROLL_SECONDS=0.4
MOVIE_AGENT_DIALOGUE_POST_ROLL_SECONDS=0.4
MOVIE_AGENT_DIALOGUE_MINIMUM_GAP_SECONDS=0.25
MOVIE_AGENT_NATIVE_AUDIO_DUCK_DB=-16
MOVIE_AGENT_MUSIC_DUCK_DB=-6
MOVIE_AGENT_AUDIO_DUCK_ATTACK_SECONDS=0.12
MOVIE_AGENT_AUDIO_DUCK_RELEASE_SECONDS=0.35
MOVIE_AGENT_MUSIC_GAIN_DB=-14
MOVIE_AGENT_POST_SUBTITLE_MODE=sidecar
# P4D GB10 measured 2026-09-09; rounded resident and sampled peak + 4 GiB.
# Zero still means UNMEASURED and makes P4A refuse audio admission.
MOVIE_AGENT_TTS_RESIDENT_GIB=11
MOVIE_AGENT_TTS_PEAK_GIB=16
MOVIE_AGENT_MUSIC_RESIDENT_GIB=11
MOVIE_AGENT_MUSIC_PEAK_GIB=15
MOVIE_AGENT_TTS_STARTUP_SECONDS=64
MOVIE_AGENT_MUSIC_STARTUP_SECONDS=34
MOVIE_AGENT_POST_PROVIDER=mock
# Default API composition: installed uses the existing real image/video/vision/audio/post adapters.
# configured respects the individual provider settings above; missing real capabilities pause production.
MOVIE_AGENT_PRODUCTION_PROFILE=installed
# Set POST_PROVIDER=ffmpeg for local real post; never falls back to Mock.
MOVIE_AGENT_POST_FFMPEG=ffmpeg
MOVIE_AGENT_POST_FFPROBE=ffprobe
MOVIE_AGENT_POST_TIMEOUT=1800
MOVIE_AGENT_POST_TEMP_ROOT=
MOVIE_AGENT_POST_LOUDNESS_LUFS=-16
MOVIE_AGENT_POST_TRUE_PEAK_DB=-1.5
MOVIE_AGENT_IMAGE_UPLOAD_MAX_BYTES=20971520

# P5 optional single-source instruction editing; only existing local model files.
MOVIE_AGENT_KONTEXT_ENABLED=false
MOVIE_AGENT_KONTEXT_ENDPOINT=http://127.0.0.1:9002
MOVIE_AGENT_KONTEXT_RESIDENT_GIB=25
MOVIE_AGENT_KONTEXT_PEAK_GIB=35
MOVIE_AGENT_KONTEXT_STARTUP_SECONDS=10

# P4A. One Spark unified pool; GiB budgets are policy headroom, not VRAM + RAM.
# Mock/injected runtimes do not contact Spark. Production composition enables this.
MOVIE_AGENT_RESOURCE_ENABLED=true
MOVIE_AGENT_RESOURCE_SYSTEM_RESERVE_GIB=4
MOVIE_AGENT_RESOURCE_SAFETY_MARGIN_GIB=8
MOVIE_AGENT_RESOURCE_WARM_IDLE_TTL=300
MOVIE_AGENT_RESOURCE_TELEMETRY_INTERVAL=30
MOVIE_AGENT_RESOURCE_SERVICE_START_TIMEOUT=600
MOVIE_AGENT_RESOURCE_SERVICE_STOP_TIMEOUT=90
MOVIE_AGENT_RESOURCE_MAX_AFFINITY_BATCH=3
MOVIE_AGENT_RESOURCE_STATE_PATH=workspace/_resource_runtime/spark-state.json
# Key-only login; these are deployment configuration, never Domain shell inputs.
MOVIE_AGENT_RESOURCE_SSH_HOST=106.13.186.155
MOVIE_AGENT_RESOURCE_SSH_PORT=6081
MOVIE_AGENT_RESOURCE_SSH_USER=Developer
