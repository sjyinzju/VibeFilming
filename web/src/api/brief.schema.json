{
  "$defs": {
    "AspectRatio": {
      "enum": [
        "16:9",
        "9:16",
        "1:1",
        "2.39:1"
      ],
      "title": "AspectRatio",
      "type": "string"
    },
    "CreativeFreedomLevel": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "CreativeFreedomLevel",
      "type": "string"
    },
    "Pacing": {
      "enum": [
        "slow",
        "measured",
        "moderate",
        "fast",
        "variable"
      ],
      "title": "Pacing",
      "type": "string"
    },
    "QualityProfile": {
      "enum": [
        "draft",
        "showcase",
        "standard",
        "high",
        "final"
      ],
      "title": "QualityProfile",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Frontend-ready user intent, with hard constraints separate from freedom.",
