{
  "name": "movie-agent-studio",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src e2e scripts *.ts *.json index.html",
    "format:check": "prettier --check src e2e scripts *.ts *.json index.html",
    "gen:api": "node scripts/gen-api.mjs && openapi-typescript src/api/openapi.json -o src/api/generated.ts --default-non-nullable false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test --config playwright.real.config.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.5",
    "@tanstack/react-query": "^5.90.0",
    "@xyflow/react": "^12.8.5",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/dagre": "^0.7.53",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.0.0",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
